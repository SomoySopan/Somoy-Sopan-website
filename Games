    <p>${again ? "আজকের চ্যালেঞ্জ তুমি আগেই শেষ করেছ।" : (ok >= 4 ? "দারুণ হয়েছে!" : "ভালো চেষ্টা!")}</p><p><b>${ic("flame")} ${BN(S.streak.n)} দিনের ধারা</b></p><p class="sub">আগামীকাল নতুন ৫টি প্রশ্ন আসবে — ধারা ধরে রাখতে রোজ এসো।</p></div>
    <a class="btn gold block" target="_blank" rel="noopener" href="https://wa.me/?text=${encodeURIComponent(txt)}">${ic("share")} বন্ধুদের জানাই (WhatsApp)</a>${examCta}${homeBtn}`;
  app.onclick = e => { if (e.target.closest("[data-act=home]")) go(home); };
}

/* ---------- দ্রুত হিসাব ---------- */
function mathQ(level) {
  let a, b, txt, ans;
  const k = Math.random();
  if (level === "j") {
    if (k < .4) { a = ri(3, 30); b = ri(2, 20); txt = `${a} + ${b}`; ans = a + b; }
    else if (k < .75) { a = ri(10, 50); b = ri(2, a); txt = `${a} − ${b}`; ans = a - b; }
    else { a = ri(2, 9); b = ri(2, 9); txt = `${a} × ${b}`; ans = a * b; }
  } else if (level === "m") {
    if (k < .25) { a = ri(20, 99); b = ri(11, 99); txt = `${a} + ${b}`; ans = a + b; }
    else if (k < .45) { a = ri(40, 150); b = ri(11, a - 1); txt = `${a} − ${b}`; ans = a - b; }
    else if (k < .75) { a = ri(3, 12); b = ri(3, 12); txt = `${a} × ${b}`; ans = a * b; }
    else { b = ri(2, 12); ans = ri(2, 12); a = b * ans; txt = `${a} ÷ ${b}`; }
  } else {
    if (k < .3) { a = ri(11, 25); b = ri(3, 12); txt = `${a} × ${b}`; ans = a * b; }
    else if (k < .5) { a = ri(11, 25); txt = `${a}²`; ans = a * a; }
    else if (k < .75) { b = [10, 20, 25, 50][ri(0, 3)]; a = ri(2, 20) * 20; txt = `${a} এর ${b}%`; ans = a * b / 100; }
    else { a = ri(5, 30); b = ri(11, 40); txt = `${a} × ${b}`; ans = a * b; }
  }
  const set = new Set([ans]); const dif = [1, 2, 3, 10, 5, 4, 20];
  let guard = 0;
  while (set.size < 4 && guard++ < 40) { const d = dif[ri(0, dif.length - 1)] * (Math.random() < .5 ? 1 : -1); const v = ans + d; if (v >= 0 && v !== ans) set.add(v); }
  return { txt, ans, opts: shuffle([...set]) };
}
function math() {
  let left = 60, score = 0, combo = 0, cur = null, wrong = 0;
  app.innerHTML = `<div class="top"><h2>${ic("bolt")} দ্রুত হিসাব</h2><span class="timer" id="tm">${BN(60)}</span></div>
    <div class="bar"><i id="tb" style="width:100%"></i></div><div class="card"><div class="top"><span class="sub">স্কোর: <b id="sc">০</b></span><span class="sub" id="cb"></span></div><div class="eq" id="eq"></div><div class="opts two" id="mo"></div></div>
    <button type="button" class="btn ghost block" data-act="home">${ic("back")} বাদ দিয়ে ফিরি</button>`;
  function next() {
    cur = mathQ(S.level); $("#eq").textContent = BN(cur.txt) + " = ?";
    $("#mo").innerHTML = cur.opts.map(o => `<button type="button" class="opt" data-v="${o}">${BN(o)}</button>`).join("");
  }
  app.onclick = e => {
    if (e.target.closest("[data-act=home]")) return go(home);
    const b = e.target.closest("[data-v]"); if (!b || left <= 0) return;
    if (+b.dataset.v === cur.ans) { score++; combo++; $("#sc").textContent = BN(score); $("#cb").innerHTML = combo >= 3 ? `${ic("flame")} ${BN(combo)} পরপর ঠিক!` : ""; next(); }
    else { wrong++; combo = 0; $("#cb").textContent = ""; b.classList.add("no"); b.disabled = true; }
  };
  next();
  timer = setInterval(() => {
    left--; $("#tm").textContent = BN(left); $("#tm").classList.toggle("low", left <= 10); $("#tb").style.width = (left / 60 * 100) + "%";
    if (left <= 0) {
      stopTimer(); if (score > (S.best.math || 0)) { S.best.math = score; save(); }
      app.innerHTML = `<div class="card big pop"><div class="stars">${"★".repeat(score >= 25 ? 3 : score >= 14 ? 2 : 1)}</div><div class="n">${BN(score)}</div><p>৬০ সেকেন্ডে ${BN(score)}টি ঠিক উত্তর, ${BN(wrong)}টি ভুল</p><p class="sub">${bestTxt("math", "টি")}</p></div>
        <button type="button" class="btn gold block" data-act="again">${ic("refresh")} আবার খেলি</button>${examCta}${homeBtn}`;
      app.onclick = ev => { if (ev.target.closest("[data-act=again]")) go(math); else if (ev.target.closest("[data-act=home]")) go(home); };
    }
  }, 1000);
}

/* ---------- শব্দ ধাঁধা ---------- */
function word() {
  app.innerHTML = `<div class="top"><h2>${ic("letters")} শব্দ ধাঁধা</h2></div><div class="games">
    <button type="button" class="g" data-w="eng"><span class="bx">${ic("letters")}</span><span><b>ইংরেজি শব্দ সাজাও</b><span class="s">এলোমেলো অক্ষর সাজিয়ে সঠিক শব্দ বানাও</span></span></button>
    <button type="button" class="g" data-w="bn"><span class="bx">${ic("pencil")}</span><span><b>সঠিক বাংলা বানান</b><span class="s">দুটির মধ্যে শুদ্ধ বানানটি বাছো</span></span></button></div>${homeBtn}`;
  app.onclick = e => { const b = e.target.closest("[data-w]"); if (b) return go(b.dataset.w === "eng" ? engScramble : bnSpell); if (e.target.closest("[data-act=home]")) go(home); };
}
function engScramble() {
  const list = shuffle(ENG[S.level]).slice(0, 8);
  let i = 0, score = 0, ans = [], used = [], tiles = [], hint = false, solvedNoHint = 0;
  function scr(w) { let t, g = 0; do { t = shuffle(w.split("")); g++; } while (t.join("") === w && g < 20); return t; }
  function draw() {
    const [w, m] = list[i]; tiles = scr(w); ans = []; used = tiles.map(() => false); hint = false;
    app.innerHTML = `<div class="top"><h2>${ic("letters")} ইংরেজি শব্দ সাজাও</h2><span class="sub">${BN(i + 1)}/${BN(list.length)}</span></div><div class="bar"><i style="width:${i / list.length * 100}%"></i></div>
      <div class="card"><p class="sub" style="text-align:center;margin:0">এই অর্থের ইংরেজি শব্দটি সাজাও</p><p class="meaning">${esc(m)}</p><div class="slots" id="sl"></div><div class="tiles" id="tl"></div>
      <div class="row2"><button type="button" class="btn ghost sm" data-act="clear">${ic("refresh")} মুছে নতুন করে</button><button type="button" class="btn ghost sm" data-act="hint">${ic("bulb")} ইঙ্গিত</button></div><div id="fb"></div></div>${homeBtn}`;
    paint();
  }
  function paint() {
    const w = list[i][0];
    $("#sl").innerHTML = w.split("").map((_, k) => `<span class="slot${ans[k] ? " f" : (hint && k === 0 ? " hint" : "")}">${ans[k] ? esc(ans[k].c) : (hint && k === 0 ? esc(w[0]) : "")}</span>`).join("");
    $("#tl").innerHTML = tiles.map((c, k) => `<button type="button" class="tile" data-t="${k}" ${used[k] ? "disabled" : ""}>${esc(c)}</button>`).join("");
  }
  function check() {
    const w = list[i][0], got = ans.map(x => x.c).join("");
    if (got === w) {
      score += hint ? 1 : 2; if (!hint) solvedNoHint++;
      $("#fb").innerHTML = `<div class="note"><b>ঠিক!</b> ${esc(w)}</div><button type="button" class="btn gold block" data-act="next">${i + 1 >= list.length ? "ফলাফল দেখি" : "পরের শব্দ"} ${ic("next")}</button>`;
      app.querySelectorAll(".tile").forEach(t => t.disabled = true);
      app.querySelectorAll(".slot").forEach(s => s.classList.add("f"));
    } else { $("#fb").innerHTML = `<div class="note" style="background:#fef2f2;color:#7f1d1d">এটি সঠিক শব্দ হয়নি — মুছে আবার চেষ্টা করো।</div>`; }
  }
  app.onclick = e => {
    if (e.target.closest("[data-act=home]")) return go(home);
    if (e.target.closest("[data-act=clear]")) { ans = []; used = used.map(() => false); $("#fb").innerHTML = ""; return paint(); }
    if (e.target.closest("[data-act=hint]")) { hint = true; return paint(); }
    if (e.target.closest("[data-act=next]")) {
      i++; if (i < list.length) return draw();
      const max = list.length * 2, key = "word_en"; if (score > (S.best[key] || 0)) { S.best[key] = score; save(); }
      app.innerHTML = `<div class="card big pop"><div class="stars">${"★".repeat(score >= max - 2 ? 3 : score >= max / 2 ? 2 : 1)}</div><div class="n">${BN(score)}<span style="font-size:26px">/${BN(max)}</span></div><p>ইঙ্গিত ছাড়া ${BN(solvedNoHint)}টি শব্দ সাজিয়েছ</p><p class="sub">${bestTxt("word_en")}</p></div>
        <button type="button" class="btn gold block" data-act="again">${ic("refresh")} আবার খেলি</button>${examCta}${homeBtn}`;
      app.onclick = ev => { if (ev.target.closest("[data-act=again]")) go(engScramble); else if (ev.target.closest("[data-act=home]")) go(home); };
      return;
    }
    const t = e.target.closest("[data-t]"); if (!t || t.disabled) return;
    const k = +t.dataset.t; if (ans.length >= list[i][0].length || used[k]) return;
    used[k] = true; ans.push({ c: tiles[k], k }); $("#fb").innerHTML = ""; paint();
    if (ans.length === list[i][0].length) check();
  };
  draw();
}
function bnSpell() {
  const list = shuffle(SPELL).slice(0, 10).map(p => ({ ok: p[0], opts: shuffle([p[0], p[1]]) }));
  let i = 0, score = 0, locked = false;
  function draw() {
    locked = false; const q = list[i];
    app.innerHTML = `<div class="top"><h2>${ic("pencil")} সঠিক বাংলা বানান</h2><span class="sub">${BN(i + 1)}/${BN(list.length)}</span></div><div class="bar"><i style="width:${i / list.length * 100}%"></i></div>
      <div class="card"><p class="q" style="text-align:center">কোন বানানটি শুদ্ধ?</p><div class="opts two">${q.opts.map((o, k) => `<button type="button" class="opt" data-o="${k}">${esc(o)}</button>`).join("")}</div><div id="fb"></div></div>${homeBtn}`;
  }
  app.onclick = e => {
    if (e.target.closest("[data-act=home]")) return go(home);
    if (e.target.closest("[data-act=next]")) {
      i++; if (i < list.length) return draw();
      if (score > (S.best.word_bn || 0)) { S.best.word_bn = score; save(); }
      app.innerHTML = `<div class="card big pop"><div class="stars">${"★".repeat(score >= 9 ? 3 : score >= 6 ? 2 : 1)}</div><div class="n">${BN(score)}<span style="font-size:26px">/${BN(list.length)}</span></div><p>শুদ্ধ বানান চিনতে পেরেছ ${BN(score)}টি</p><p class="sub">${bestTxt("word_bn")}</p></div>
        <button type="button" class="btn gold block" data-act="again">${ic("refresh")} আবার খেলি</button>${examCta}${homeBtn}`;
      app.onclick = ev => { if (ev.target.closest("[data-act=again]")) go(bnSpell); else if (ev.target.closest("[data-act=home]")) go(home); };
      return;
    }
    const b = e.target.closest("[data-o]"); if (!b || locked) return; locked = true;
    const q = list[i], right = q.opts[+b.dataset.o] === q.ok;
    app.querySelectorAll(".opt").forEach((x, k) => { x.disabled = true; if (q.opts[k] === q.ok) x.classList.add("ok"); });
    if (right) score++; else b.classList.add("no");
    $("#fb").innerHTML = `<div class="note"><b>${right ? "ঠিক!" : "শুদ্ধ বানান:"}</b> ${esc(q.ok)}</div><button type="button" class="btn gold block" data-act="next">${i + 1 >= list.length ? "ফলাফল দেখি" : "পরেরটি"} ${ic("next")}</button>`;
  };
  draw();
}

/* ---------- মেমোরি কার্ড ---------- */
function mem() {
  const key = Object.keys(MEMSETS)[Math.floor(Math.random() * 2)], set = MEMSETS[key];
  const pairs = shuffle(set.pairs).slice(0, 6);
  const cards = shuffle(pairs.flatMap((p, id) => [{ id, t: p[0] }, { id, t: p[1] }]));
  let open = [], moves = 0, matched = 0, t0 = 0, busy = false;
  app.innerHTML = `<div class="top"><h2>${ic("cards")} মেমোরি কার্ড</h2><span class="sub">চাল: <b id="mv">০</b> • <b id="tt">০</b> সেকেন্ড</span></div>
    <p class="sub" style="margin:0">জোড়া মেলাও — ${esc(set.name)}</p>
    <div class="mem">${cards.map((c, i) => `<button type="button" class="c" data-c="${i}" aria-label="কার্ড ${BN(i + 1)}"><span class="in"><span class="fr">${ic("star")}</span><span class="bk">${esc(c.t)}</span></span></button>`).join("")}</div>
    <button type="button" class="btn ghost block" data-act="home">${ic("back")} বাদ দিয়ে ফিরি</button>`;
  app.onclick = e => {
    if (e.target.closest("[data-act=home]")) return go(home);
    const b = e.target.closest("[data-c]"); if (!b || busy || b.classList.contains("f") || b.classList.contains("m")) return;
    if (!t0) { t0 = Date.now(); timer = setInterval(() => { const tt = $("#tt"); if (tt) tt.textContent = BN(Math.floor((Date.now() - t0) / 1000)); }, 500); }
    b.classList.add("f"); open.push(b);
    if (open.length < 2) return;
    moves++; $("#mv").textContent = BN(moves); busy = true;
    const [x, y] = open; open = [];
    if (cards[+x.dataset.c].id === cards[+y.dataset.c].id) {
      x.classList.add("m"); y.classList.add("m"); busy = false; matched++;
      if (matched === pairs.length) {
        stopTimer(); const secs = Math.max(1, Math.round((Date.now() - t0) / 1000));
        if (!S.best.mem || moves < S.best.mem) { S.best.mem = moves; save(); }
        setTimeout(() => {
          app.innerHTML = `<div class="card big pop"><div class="stars">${"★".repeat(moves <= 10 ? 3 : moves <= 14 ? 2 : 1)}</div><div class="n">${BN(moves)}<span style="font-size:26px"> চালে</span></div><p>${BN(secs)} সেকেন্ডে সব জোড়া মিলিয়েছ</p><p class="sub">সবচেয়ে কম চাল: ${BN(S.best.mem)}</p></div>
            <button type="button" class="btn gold block" data-act="again">${ic("refresh")} আবার খেলি</button>${examCta}${homeBtn}`;
          app.onclick = ev => { if (ev.target.closest("[data-act=again]")) go(mem); else if (ev.target.closest("[data-act=home]")) go(home); };
        }, 600);
      }
    } else setTimeout(() => { x.classList.remove("f"); y.classList.remove("f"); busy = false; }, 800);
  };
}

/* ---- মূল পাতার ক্লিক ---- */
function bindHome() {
  app.onclick = e => {
    const lv = e.target.closest("[data-lv]"); if (lv) { S.level = lv.dataset.lv; save(); return home(); }
    const g = e.target.closest("[data-g]"); if (!g) return;
    const m = { daily, climb, math, word, mem }[g.dataset.g]; if (m) go(m);
  };
}
const _home = home; home = function () { _home(); bindHome(); };
home();
</script>
