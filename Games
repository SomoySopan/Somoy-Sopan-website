/* ---------- সোপান বেয়ে ওঠো (ও আজকের চ্যালেঞ্জ একই ইঞ্জিন) ---------- */
function quizRun(cfg) {                         // cfg: {qs, title, stairs:boolean, onDone(correct,total,step)}
  const st = { i: 0, ok: 0, step: 0, locked: false };
  const N = cfg.qs.length;
  function stairsHtml() {
    return `<div class="stairs" aria-hidden="true">${Array.from({ length: 11 }, (_, k) => `<div class="st${k <= st.step ? " on" : ""}${k === 10 && st.step >= 10 ? " top" : ""}" style="height:${14 + k * 12.5}px">${k === st.step ? `<span class="me">${ic("cap")}</span>` : ""}${k === 10 ? `<span class="goal">${ic("trophy")}</span>` : ""}</div>`).join("")}</div>`;
  }
  function draw() {
    const q = cfg.qs[st.i];
    app.innerHTML = `<div class="top"><h2>${cfg.title}</h2><span class="sub">প্রশ্ন ${BN(st.i + 1)}/${BN(N)}</span></div>
      <div class="bar"><i style="width:${(st.i / N) * 100}%"></i></div>
      ${cfg.stairs ? `<div class="card" style="padding-top:34px">${stairsHtml()}<p class="sub" id="stp" style="text-align:center;margin:8px 0 0">এখন ${BN(st.step)} ধাপে — শীর্ষে পৌঁছাতে ১০ ধাপ</p></div>` : ""}
      <div class="card"><span class="tag">${esc(q.sub)}</span><p class="q">${esc(q.q)}</p>
      <div class="opts">${q.opts.map((o, i) => `<button type="button" class="opt" data-o="${i}">${esc(o.t)}</button>`).join("")}</div><div id="fb"></div></div>
      <button type="button" class="btn ghost block" data-act="home">${ic("back")} বাদ দিয়ে ফিরি</button>`;
    st.locked = false;
  }
  app.onclick = e => {
    const home_ = e.target.closest("[data-act=home]"); if (home_) return go(home);
    if (e.target.closest("[data-act=next]")) { st.i++; return st.i >= N ? cfg.onDone(st.ok, N, st.step) : (draw(), window.scrollTo(0, 0)); }
    const b = e.target.closest("[data-o]"); if (!b || st.locked) return;
    st.locked = true;
    const q = cfg.qs[st.i], pick = q.opts[+b.dataset.o], right = pick.ok;
    app.querySelectorAll(".opt").forEach((x, i) => { x.disabled = true; if (q.opts[i].ok) x.classList.add("ok"); });
    if (!right) b.classList.add("no");
    if (right) { st.ok++; st.step = Math.min(10, st.step + 1); } else st.step = Math.max(0, st.step - 1);
    $("#fb").innerHTML = `<div class="note"><b>${right ? "ঠিক!" : "আরেকটু হলেই হতো।"}</b> ${esc(q.exp)}</div><button type="button" class="btn gold block" data-act="next">${st.i + 1 >= N ? "ফলাফল দেখি" : "পরের প্রশ্ন"} ${ic("next")}</button>`;
    if (cfg.stairs) { const sd = app.querySelector(".stairs"); if (sd) { sd.outerHTML = stairsHtml(); } const sp = $("#stp"); if (sp) sp.textContent = `এখন ${BN(st.step)} ধাপে — শীর্ষে পৌঁছাতে ১০ ধাপ`; }
    $("#fb").scrollIntoView({ block: "nearest", behavior: "smooth" });
  };
  draw();
}
function climb() {
  const qs = shuffle(pool(S.level)).slice(0, 10).map(q => mkQ(q));
  quizRun({ qs, title: `${ic("stairs")} সোপান বেয়ে ওঠো`, stairs: true, onDone: (ok, n, step) => {
    if (step > (S.best.climb || 0)) { S.best.climb = step; save(); }
    const msg = step >= 10 ? "অসাধারণ! তুমি সোপানের শীর্ষে পৌঁছে গেছ!" : step >= 7 ? "দারুণ! শীর্ষের খুব কাছে ছিলে।" : step >= 4 ? "ভালো চেষ্টা! আবার খেললে আরও ওপরে উঠবে।" : "চলো আবার চেষ্টা করি — প্রতিটি ভুল থেকেই শেখা হয়।";
    app.innerHTML = `<div class="card big pop"><div class="stars">${"★".repeat(step >= 10 ? 3 : step >= 6 ? 2 : 1)}</div><div class="n">${BN(step)}<span style="font-size:26px">/১০ ধাপ</span></div><p>${BN(ok)}টি ঠিক উত্তর, ${BN(n - ok)}টি ভুল</p><p><b>${msg}</b></p><p class="sub">${bestTxt("climb", " ধাপ")}</p></div>
      <button type="button" class="btn gold block" data-act="again">${ic("refresh")} আবার খেলি</button>${examCta}${homeBtn}`;
    app.onclick = e => { if (e.target.closest("[data-act=again]")) go(climb); else if (e.target.closest("[data-act=home]")) go(home); };
  } });
}

