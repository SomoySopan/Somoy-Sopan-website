function daily() {
  const t = dayKey();
  if (S.daily.date === t) return dailyDone(S.daily.score, S.daily.total, true);
  const r = rng(hash(t + S.level));
  const qs = shuffle(pool(S.level), r).slice(0, 5).map(q => mkQ(q, r));
  quizRun({ qs, title: `${ic("calendar")} আজকের চ্যালেঞ্জ`, stairs: false, onDone: (ok, n) => {
    const y = dayKey(new Date(Date.now() - 864e5));
    S.streak = { last: t, n: S.streak.last === y ? S.streak.n + 1 : (S.streak.last === t ? S.streak.n : 1) };
    S.daily = { date: t, score: ok, total: n }; save(); dailyDone(ok, n, false);
  } });
}
function dailyDone(ok, n, again) {
  const txt = `আজকের চ্যালেঞ্জে ${BN(ok)}/${BN(n)} পেয়েছি! ধারা ${BN(S.streak.n)} দিন। তুমিও খেলে দেখো: ` + location.href.split("#")[0];
