<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>খেলে শেখো — সময় সোপান</title>
<meta name="description" content="সময় সোপানের শিক্ষামূলক ছোট গেমস — সোপান বেয়ে ওঠো, দ্রুত হিসাব, শব্দ ধাঁধা, মেমোরি কার্ড ও আজকের চ্যালেঞ্জ।">
<meta name="theme-color" content="#141f85">
<link rel="icon" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-192.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root { --navy: #141f85; --navy2: #1b2aa6; --navy3: #0c1458; --gold: #f0b000; --gold2: #f9cf3d; --ink: #1e293b; --mut: #64748b; --line: #e2e8f0; --bg: #f5f6fd; --ok: #15803d; --bad: #b91c1c; }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html { scroll-behavior: smooth; }
  body { margin: 0; font-family: 'Hind Siliguri', system-ui, sans-serif; background: var(--bg); color: var(--ink); line-height: 1.55; }
  .ic { width: 1.15em; height: 1.15em; vertical-align: -0.2em; display: inline-block; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
  header { position: sticky; top: 0; z-index: 20; background: #fff; border-bottom: 1px solid var(--line); }
  .hd { max-width: 560px; margin: 0 auto; padding: 10px 16px; display: flex; align-items: center; gap: 10px; }
  .hd img { width: 38px; height: 38px; border-radius: 8px; }
  .hd b { color: var(--navy); font-size: 18px; display: block; line-height: 1.1; }
  .hd small { color: var(--mut); font-size: 11px; }
  .hd a.back { margin-left: auto; color: var(--navy2); font-weight: 600; font-size: 14px; text-decoration: none; padding: 8px 10px; border-radius: 10px; border: 1px solid var(--line); white-space: nowrap; }
  main { max-width: 560px; margin: 0 auto; padding: 16px 16px 90px; }
  h1, h2, h3 { margin: 0; color: var(--navy); }
  .hero { background: linear-gradient(135deg, var(--navy3), var(--navy2) 60%, #2a3bbd); color: #fff; border-radius: 22px; padding: 20px; position: relative; overflow: hidden; }
  .hero::after { content: ""; position: absolute; right: -40px; top: -40px; width: 160px; height: 160px; border-radius: 50%; background: radial-gradient(circle, rgba(249,207,61,.45), transparent 65%); }
  .hero h1 { color: #fff; font-size: 26px; }
  .hero p { margin: 6px 0 0; color: #dbe2ff; font-size: 14px; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 14px; }
  .chip { border: 1px solid rgba(255,255,255,.35); color: #fff; background: rgba(255,255,255,.1); padding: 7px 12px; border-radius: 999px; font: inherit; font-size: 13px; cursor: pointer; }
  .chip.on { background: var(--gold); border-color: var(--gold); color: #3b2a00; font-weight: 700; }
  .stat { display: flex; gap: 10px; margin: 14px 0; }
  .stat div { flex: 1; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 10px; text-align: center; font-size: 12px; color: var(--mut); }
  .stat b { display: block; font-size: 20px; color: var(--navy); }
  .games { display: grid; gap: 12px; }
  .g { display: flex; gap: 14px; align-items: center; background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 14px; text-align: left; font: inherit; color: inherit; cursor: pointer; width: 100%; box-shadow: 0 1px 2px rgba(15,23,42,.04); }
  .g:active { transform: scale(.985); }
  .g .bx { width: 52px; height: 52px; border-radius: 14px; background: #eef1fd; color: var(--navy2); display: grid; place-items: center; font-size: 28px; flex-shrink: 0; }
  .g b { color: var(--navy); font-size: 17px; display: block; }
  .g span.s { color: var(--mut); font-size: 13px; }
  .g em { margin-left: auto; font-style: normal; font-size: 11px; color: #92400e; background: #fef3c7; border-radius: 999px; padding: 3px 9px; white-space: nowrap; }
  .g.today .bx { background: #fff7e0; color: #b45309; }
  .card { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 16px; margin-top: 12px; }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 10px; }
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 0 18px; border-radius: 14px; border: 0; font: inherit; font-weight: 700; font-size: 16px; cursor: pointer; background: var(--navy2); color: #fff; text-decoration: none; }
  .btn.gold { background: var(--gold); color: #3b2a00; }
  .btn.ghost { background: #fff; color: var(--navy2); border: 1px solid #c7d0f5; }
  .btn.block { display: flex; width: 100%; margin-top: 10px; }
  .btn.sm { min-height: 38px; padding: 0 12px; font-size: 14px; border-radius: 10px; }
  .q { font-size: 19px; font-weight: 600; color: var(--ink); margin: 6px 0 14px; }
  .tag { display: inline-block; font-size: 12px; color: var(--navy2); background: #eef1fd; padding: 2px 10px; border-radius: 999px; }
  .opts { display: grid; gap: 10px; }
  .opt { min-height: 52px; padding: 10px 14px; text-align: left; font: inherit; font-size: 17px; border-radius: 14px; border: 2px solid var(--line); background: #fff; color: var(--ink); cursor: pointer; }
  .opt:active { transform: scale(.985); }
  .opt.ok { border-color: var(--ok); background: #f0fdf4; color: #14532d; }
  .opt.no { border-color: var(--bad); background: #fef2f2; color: #7f1d1d; animation: shake .35s; }
  .opts.two { grid-template-columns: 1fr 1fr; }
  .opts.two .opt { text-align: center; font-size: 22px; }
  .note { margin-top: 12px; padding: 10px 12px; border-radius: 12px; background: #eef1fd; font-size: 14px; color: #1e2a78; }
  .bar { height: 8px; background: #e5e7f5; border-radius: 99px; overflow: hidden; }
  .bar i { display: block; height: 100%; background: linear-gradient(90deg, var(--gold), var(--gold2)); transition: width .25s linear; }
  .stairs { display: flex; align-items: flex-end; gap: 3px; height: 150px; padding: 0 2px; }
  .stairs .st { flex: 1; position: relative; background: #dde3fa; border-radius: 5px 5px 0 0; transition: background .3s; }
  .stairs .st.on { background: linear-gradient(180deg, var(--navy2), var(--navy)); }
  .stairs .st.top { background: linear-gradient(180deg, var(--gold2), var(--gold)); }
  .me { color: #3b2a00; position: absolute; left: 50%; bottom: 100%; transform: translateX(-50%); width: 30px; height: 30px; border-radius: 50%; background: var(--gold); color: #3b2a00; display: grid; place-items: center; font-size: 17px; box-shadow: 0 2px 6px rgba(0,0,0,.25); animation: hop .5s ease; z-index: 2; margin-bottom: 3px; }
  .goal { position: absolute; right: 2px; top: -2px; color: var(--gold); font-size: 20px; }
  .big { text-align: center; padding: 10px 0; }
  .big .n { font-size: 56px; font-weight: 700; color: var(--navy); line-height: 1.1; }
  .big p { margin: 4px 0; color: var(--mut); }
  .timer { font-size: 22px; font-weight: 700; color: var(--navy); }
  .timer.low { color: var(--bad); }
  .eq { text-align: center; font-size: 40px; font-weight: 700; color: var(--navy); margin: 14px 0 16px; letter-spacing: 1px; }
  .slots, .tiles { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin: 12px 0; }
  .slot { width: 42px; height: 50px; border-radius: 10px; border: 2px dashed #b7c0ee; display: grid; place-items: center; font-size: 24px; font-weight: 700; color: var(--navy); text-transform: uppercase; background: #fff; }
  .slot.f { border-style: solid; border-color: var(--navy2); background: #eef1fd; }
  .slot.hint { border-color: var(--gold); background: #fff7e0; }
  .tile { width: 46px; height: 54px; border-radius: 12px; border: 0; background: var(--navy2); color: #fff; font: inherit; font-size: 24px; font-weight: 700; text-transform: uppercase; cursor: pointer; box-shadow: 0 3px 0 var(--navy3); }
  .tile:disabled { opacity: .25; box-shadow: none; }
  .meaning { text-align: center; font-size: 20px; font-weight: 600; margin: 6px 0; }
  .mem { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 12px; }
  .c { aspect-ratio: 1 / 1.05; perspective: 600px; border: 0; padding: 0; background: none; cursor: pointer; font: inherit; }
  .c .in { display: block; position: relative; width: 100%; height: 100%; transition: transform .35s; transform-style: preserve-3d; }
  .c.f .in, .c.m .in { transform: rotateY(180deg); }
  .c .fr, .c .bk { position: absolute; inset: 0; border-radius: 14px; display: grid; place-items: center; backface-visibility: hidden; text-align: center; padding: 4px; }
  .c .fr { background: linear-gradient(135deg, var(--navy2), var(--navy3)); color: var(--gold2); font-size: 30px; }
  .c .bk { background: #fff; border: 2px solid #c7d0f5; transform: rotateY(180deg); font-size: 19px; font-weight: 700; color: var(--navy); line-height: 1.2; }
  .c.m .bk { background: #f0fdf4; border-color: var(--ok); color: #14532d; }
  .c .fr .ic { font-size: 34px; } .c .fr path { fill: #f9cf3d; }
  .stars { font-size: 34px; color: var(--gold); letter-spacing: 4px; }
  .sub { color: var(--mut); font-size: 14px; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .foot { text-align: center; color: var(--mut); font-size: 12px; margin-top: 22px; }
  @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
  @keyframes hop { 0% { transform: translate(-50%, 14px) scale(.7); } 60% { transform: translate(-50%, -6px) scale(1.1); } 100% { transform: translate(-50%, 0) scale(1); } }
  @keyframes pop { 0% { transform: scale(.6); opacity: 0; } 70% { transform: scale(1.1); } 100% { transform: scale(1); opacity: 1; } }
  .pop { animation: pop .45s ease; }
  @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
</style>
